# ── Reference-host runtime artifacts ─────────────────────────────────────────
# Per-deployment signing keys, SQLite DBs, audit logs. Never committed.
examples/hosts/postgres/data/
examples/hosts/sqlite/data/
apps/workflow-engine/backend/typescript/data/

# ── apps/workflow-engine: stray colocated TypeScript emit ────────────────────
# `tsc` invoked without `--noEmit` (e.g., `tsc -b` outside the build
# script) writes a `.js`+`.js.map` next to every `.ts`/`.tsx` source.
# Source of truth is always the `.ts`/`.tsx` file — Vite imports those
# directly. The general `dist/` rule above handles the BE bundle
# output; these rules catch the colocated emit and the BE's `lib/`
# directory that `tsc -b` sometimes targets. Scoped to this subtree so
# legitimate `.js` files elsewhere in the repo (scripts/, etc.) are
# untouched.
apps/workflow-engine/**/src/**/*.js
apps/workflow-engine/**/src/**/*.js.map
apps/workflow-engine/backend/typescript/lib/

# ── Registry: un-ignore the publication artifacts ────────────────────────────
# The root `*.tgz` rule above would otherwise block every new signed pack
# tarball under `registry/v1/packs/**`. These are intentional content (the
# verifiable artifacts consumers download), NOT npm-pack development output.
# Companion signatures + public keys are explicitly un-ignored too so a
# future broader rule can't silently break the registry.
!registry/**/*.tgz
!registry/**/*.sig
!registry/keys/*.pub
!packs/**/*.sig

# Public keys distributed with community-tier packs ARE meant to be
# tracked — they're the verifier counterpart to detached signatures.
# Private keys MUST NOT be committed; they live in the operator's
# secrets vault per docs/PACKS-MVP-PLAN.md §"Operational note."
!packs/**/keys/*.pub.pem

