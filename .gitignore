# ── Node / TypeScript ────────────────────────────────────────────────────────
# No trailing slash: also ignores an accidental `node_modules` *symlink*
# (a trailing-slash pattern matches only directories, which let a stray
# self-referential symlink slip into git history once).
node_modules
dist/
*.tsbuildinfo

# npm pack output (run `npm pack` to regenerate from source).
*.tgz

# Yarn berry / pnpm / npm caches & state.
.npm/
.yarn/cache
.yarn/install-state.gz
.pnp.cjs
.pnp.loader.mjs
.pnpm-store/

# npm/yarn debug logs.
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Dev-tool caches (ESLint, Stylelint, Turborepo, Vite, Next, Parcel, generic).
.eslintcache
.stylelintcache
.turbo/
.vite/
.next/
.parcel-cache/
.cache/

# Node REPL history (sometimes left in repo root by interactive sessions).
.node_repl_history

# ── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
.venv/
venv/
.mypy_cache/
.pytest_cache/
.ruff_cache/
*.egg-info/
build/

# ── Go ───────────────────────────────────────────────────────────────────────
*.test
*.out

# ── Environment & secrets ────────────────────────────────────────────────────
.env
.env.local
.env.*.local
.envrc.local
.direnv/
*.pem
*.key

# Sentry CLI auth.
.sentryclirc

# ── Editors / IDEs ───────────────────────────────────────────────────────────
.vscode/
.idea/
*.code-workspace
.history/
*.iml
*.iws
*.ipr
.netrwhist
Session.vim
*.swp
*.swo
*.bak

# Universal ctags / etags (root-anchored — wouldn't want to hide a deliberately-
# named `tags` file deeper in the tree).
/tags
/TAGS
/.tags

# ── OS-specific ──────────────────────────────────────────────────────────────
.DS_Store
.!*
._*
.AppleDouble
.LSOverride
.Spotlight-V100
.Trashes
Thumbs.db

# ── Git merge / patch artifacts ──────────────────────────────────────────────
*.orig
*.rej

# ── Coverage ─────────────────────────────────────────────────────────────────
coverage/
.coverage
*.cover
.nyc_output/
lcov.info
*.lcov

# ── Logs & temp files ────────────────────────────────────────────────────────
*.log
*.tmp
*.temp
*~

# ── Database files ───────────────────────────────────────────────────────────
*.db
*.sqlite
*.sqlite3
# ── Process / daemon state ───────────────────────────────────────────────────
*.pid

# ── Claude Code per-developer runtime state ──────────────────────────────────
# Scheduled-task locks, session logs, etc. Tracked skill definitions under
# `.claude/skills/` are NOT ignored — only the runtime artifacts.
.claude/*.lock
.claude/scheduled_tasks.lock
.claude/sessions/
.claude/logs/
# Per-developer agent memory. Its canonical home is ~/.claude/projects/<slug>/memory/;
# a copy under the repo is an accidental commit of one developer's notes, not corpus.
.claude/projects/
/data/

# ── Per-developer planning notes ─────────────────────────────────────────────
# `plans/` is the staging area for working roadmaps, gap analyses, and
# protocol-extension sketches that may or may not promote to an RFC.
# Existing files committed to plans/ stay tracked (gitignore doesn't
# untrack); this rule prevents NEW planning docs from accumulating as
# untracked working-tree noise. To commit a new plan deliberately, use
# `git add -f plans/<file>.md`.
plans/*.md


# graphify knowledge-graph output (local, not tracked)
graphify-out/

# ── Extracted-repo residue ───────────────────────────────────────────────────
# `apps/` moved to openwop/openwop-app, `examples/` to openwop/openwop-examples,
# `packs/` + `registry/` to openwop/openwop-registry, `sdk/` to openwop/openwop-sdks
# and `site/` to openwop/openwop-site; none of these directories holds tracked content in this monorepo anymore. Local checkouts
# still carry pre-extraction build residue (lockfiles, Rust target/, dist
# output, runtime DBs/keys) — ignore the directories wholesale. New work on
# those surfaces belongs in the extracted repos, not here.
/apps/
/examples/
/packs/
/registry/
/sdk/
/site/
