{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openwop.dev/spec/v2/event-codemap.schema.json",
  "title": "OpenWOP v1→v2 event-type codemap",
  "description": "Shape of spec/v1/event-codemap.json (v2 charter C.4/C.9, Phase 1 item 9): one row per RunEventType with its payload $def and a proposed v2 name. Data, not a wire artifact; kept out of schemas/. Generated by scripts/generate-event-codemap.mjs; the v2 C.4 child RFC edits it and every host backfills its event log from it.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "$comment",
    "version",
    "updated",
    "grammar",
    "counts",
    "rows"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "const": "./event-codemap.schema.json"
    },
    "$comment": {
      "type": "string"
    },
    "version": {
      "type": "integer",
      "const": 1
    },
    "updated": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "grammar": {
      "type": "string"
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rows",
        "review",
        "overridden"
      ],
      "properties": {
        "rows": {
          "type": "integer"
        },
        "review": {
          "type": "integer"
        },
        "overridden": {
          "type": "integer"
        }
      }
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "v1",
          "v2",
          "payloadDef",
          "status",
          "review",
          "notes"
        ],
        "properties": {
          "v1": {
            "type": "string",
            "minLength": 1
          },
          "v2": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*\\.[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
          },
          "v2Override": {
            "type": "string",
            "description": "Hand-decided v2 name (C.4 decision); wins over the mechanical proposal and survives regeneration."
          },
          "payloadDef": {
            "type": [
              "string",
              "null"
            ],
            "description": "Key under run-event-payloads.schema.json $defs."
          },
          "status": {
            "type": "string",
            "enum": [
              "proposed",
              "decided"
            ]
          },
          "review": {
            "type": "boolean",
            "description": "true when the mechanical proposal needs a semantic decision (tense, domain rename, reserved prefix)."
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "note": {
            "type": "string"
          }
        }
      }
    }
  }
}
