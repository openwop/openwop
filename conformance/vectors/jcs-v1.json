      "canonical": "{\"name\":\"café\"}",
      "sha256": "645fa443126a8954fc6d871912b8fc67bc2ee8feae417efe55546251962ca74d"
    },
    {
      "id": "nfd-decomposed",
      "why": "U+0065 U+0301 (decomposed). Pair with nfc-composed.",
