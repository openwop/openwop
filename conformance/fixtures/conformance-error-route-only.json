    {
      "id": "start",
      "typeId": "core.noop",
      "name": "Start",
      "position": {
        "x": 0,
        "y": 0
      },
      "config": {},
      "inputs": {}
    },
    {
      "id": "on-fail",
      "typeId": "core.noop",
      "name": "On failure",
      "position": {
        "x": 200,
        "y": 0
      },
      "config": {},
      "inputs": {}
    }
  ],
  "edges": [
    {
      "id": "start-on-fail",
      "sourceNodeId": "start",
      "targetNodeId": "on-fail",
      "triggerRule": "any_failed"
    }
  ],
  "triggers": [
    {
      "id": "manual",
      "type": "manual",
      "enabled": true
    }
  ],
  "variables": [],
  "metadata": {
    "tags": [
      "conformance",
      "skipped-terminals"
    ]
  },
  "settings": {
    "timeout": 60000,
    "maxRetries": 0
  }
