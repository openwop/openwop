{
  "suiteId": "core.openwop.evals.conformance-eval-trials",
  "version": "1.0.0",
  "targetAgentId": "core.conformance.agents.scripted",
  "modes": [
    "golden"
  ],
  "trials": {
    "count": 3,
    "k": 2,
    "passRule": "all"
  },
  "tasks": [
    {
      "taskId": "always-passes",
      "input": {
        "script": [
          {
            "tool": "conformance.eval:lookup",
            "arguments": {
              "orderId": "o-1"
            }
          }
        ],
        "output": "done"
      },
      "expected": {
        "kind": "golden",
        "match": {
          "strategy": "contains",
          "value": "done"
        }
      }
    },
    {
      "taskId": "always-fails",
      "input": {
        "script": [
          {
            "tool": "conformance.eval:lookup",
            "arguments": {
              "orderId": "o-1"
            }
          }
        ],
        "output": "done"
      },
      "expected": {
        "kind": "golden",
        "match": {
          "strategy": "contains",
          "value": "never-in-output"
        }
      }
    }
  ]
}
