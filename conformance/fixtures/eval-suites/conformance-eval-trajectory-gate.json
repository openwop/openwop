{
  "suiteId": "core.openwop.evals.conformance-eval-trajectory-gate",
  "version": "1.0.0",
  "targetAgentId": "core.conformance.agents.scripted",
  "modes": [
    "golden"
  ],
  "thresholds": {
    "passScore": 0.6
  },
  "tasks": [
    {
      "taskId": "path-matched",
      "input": {
        "script": [
          {
            "tool": "conformance.eval:lookup",
            "arguments": {
              "orderId": "o-1"
            }
          }
        ],
        "output": "done"
      },
      "expected": {
        "kind": "golden",
        "match": {
          "strategy": "contains",
          "value": "done"
        },
        "trajectory": {
          "match": "any-order",
          "calls": [
            {
              "tool": "conformance.eval:lookup"
            }
          ],
          "forbidden": [
            "conformance.eval:refund-all"
          ]
        }
      }
    },
    {
      "taskId": "path-wrong",
      "input": {
        "script": [
          {
            "tool": "conformance.eval:lookup",
            "arguments": {
              "orderId": "o-1"
            }
          },
          {
            "tool": "conformance.eval:refund-all",
            "arguments": {}
          }
        ],
        "output": "done"
      },
      "expected": {
        "kind": "golden",
        "match": {
          "strategy": "contains",
          "value": "done"
        },
        "trajectory": {
          "match": "any-order",
          "calls": [
            {
              "tool": "conformance.eval:lookup"
            }
          ],
          "forbidden": [
            "conformance.eval:refund-all"
          ]
        }
      }
    }
  ]
}
