        "title": "Conformance loopback review (conformance-loopback-refine-fail)",
        "description": "Conformance suite — refine to loop back to draft.",
        "actions": [
          "accept",
          "reject",
          "refine"
        ]
      },
      "inputs": {}
    },
    {
      "id": "apply",
      "typeId": "core.noop",
