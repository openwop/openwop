{
  "name": "@openwop/cli",
  "version": "0.2.0",
  "description": "OpenWOP CLI for operating the workflow-engine demo app and OpenWOP-compatible hosts.",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openwop/openwop.git",
    "directory": "cli"
  },
  "homepage": "https://app.openwop.dev/cli",
  "bugs": {
    "url": "https://github.com/openwop/openwop/issues"
  },
  "bin": {
    "openwop": "dist/openwop.js"
  },
  "files": [
    "dist",
    "install.sh",
    "README.md"
  ],
  "scripts": {
    "build": "rm -rf dist && esbuild src/openwop.ts src/cli.ts --bundle --platform=node --target=node20 --format=esm --outdir=dist --packages=external --banner:js=\"import { createRequire as _cr } from 'module'; const require = _cr(import.meta.url);\"",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test test/*.test.mjs"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0"
  },
  "peerDependencies": {
    "@whiskeysockets/baileys": ">=6",
    "discord.js": ">=14"
  },
  "peerDependenciesMeta": {
    "@whiskeysockets/baileys": {
      "optional": true
    },
    "discord.js": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20"
  }
}
