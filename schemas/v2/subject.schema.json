{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "issuer",
    "subjectId",
    "tenant",
    "lane",
    "kind"
  ],
  "properties": {
    "issuer": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^\\S+$",
      "description": "Trust root (RFC 0170 §B.2); urn:openwop:legacy for a run that predates subject emission (§A.3)."
    },
    "subjectId": {
      "$ref": "ids.schema.json#/$defs/subjectId"
    },
    "tenant": {
      "$ref": "ids.schema.json#/$defs/tenantId"
    },
    "lane": {
      "type": "string",
      "enum": [
        "api-key",
        "oauth2",
        "oidc",
        "mtls",
        "saml",
        "scim",
        "ldap",
        "workload",
        "session",
        "anonymous"
      ]
    },
    "kind": {
      "type": "string",
      "enum": [
        "user",
        "agent",
        "anonymous",
        "workload"
      ]
    },
    "keyClass": {
      "type": "string",
      "enum": [
        "opaque-idp",
        "configured-immutable"
      ]
    },
    "actor": {
      "$ref": "#/$defs/actor1",
      "description": "Who acts on this subject's behalf; depth bounded at four by the $defs chain (RFC 0170 §A.2)."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "anonymous"
          }
        }
      },
      "then": {
        "properties": {
          "lane": {
            "const": "anonymous"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "lane": {
            "const": "anonymous"
          }
        }
      },
      "then": {
        "properties": {
          "kind": {
            "const": "anonymous"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "lane": {
            "enum": [
              "saml",
              "scim"
            ]
          }
        }
      },
      "then": {
        "required": [
          "keyClass"
        ]
      },
      "else": {
        "not": {
          "required": [
            "keyClass"
          ]
        }
      }
    }
  ],
