{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openwop.dev/spec/v2/declaration.schema.json",
  "title": "OpenWOP v2 capability declaration file (RFC 0169 §B)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "version",
    "updated",
    "witnessClasses",
    "extensionsKeyPattern",
    "reservedOrgs",
    "metadata",
    "families",
    "profiles"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "$comment": {
      "type": "string"
    },
    "version": {
      "type": "string",
      "pattern": "^2\\.[0-9]+$"
    },
    "updated": {
      "type": "string",
      "format": "date"
    },
    "witnessClasses": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "witnessable-unaided",
          "witnessable-gated",
          "seam-gated",
          "claims-check",
          "negative-existence"
        ]
      }
    },
    "extensionsKeyPattern": {
      "type": "string"
    },
    "reservedOrgs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "metadata": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "kind",
          "schema",
          "disposition"
        ],
        "properties": {
          "key": {
            "type": "string"
          },
          "kind": {
            "const": "metadata"
          },
          "schema": {
            "type": "string"
          },
          "disposition": {
            "enum": [
              "kept",
              "deleted"
            ]
          },
          "note": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "families": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "key",
              "anchor",
              "reason"
            ],
            "properties": {
              "key": {
                "type": "string"
              },
              "anchor": {
                "const": "deleted"
              },
              "reason": {
                "type": "string"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "key",
              "kind",
              "anchor",
              "section",
              "peerDependencyId",
              "witness",
              "maturity",
              "facets",
              "floorScenarios",
              "requirementIds"
            ],
            "properties": {
              "key": {
                "type": "string",
                "pattern": "^[a-z][A-Za-z0-9]*$"
              },
              "kind": {
                "const": "family"
              },
              "anchor": {
                "enum": [
                  "core",
                  "ext"
                ]
              },
              "section": {
                "type": "string"
              },
              "peerDependencyId": {
                "type": "string"
              },
              "witness": {
                "enum": [
                  "witnessable-unaided",
                  "witnessable-gated",
                  "seam-gated",
                  "claims-check",
                  "negative-existence"
                ]
              },
              "maturity": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "technical",
                  "adoption"
                ],
                "properties": {
                  "technical": {
                    "enum": [
                      "experimental",
                      "stable",
                      "deprecated"
                    ]
                  },
                  "adoption": {
                    "enum": [
                      "none",
                      "single-witness",
                      "multi-witness",
                      "independent"
                    ]
                  },
                  "until": {
                    "type": "string"
                  }
                }
              },
              "facets": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "floorScenarios": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "requirementIds": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "owningRfc": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "reason": {
                "type": "string"
              },
              "note": {
                "type": "string"
              },
              "disposition": {
                "enum": [
                  "externally-gated"
                ]
              },
              "facetsFrom": {
                "type": "string"
              }
            }
          }
        ]
      }
    },
    "profiles": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "predicate"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "predicate": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "families": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "metadata": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "floorScenarios": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "requirementIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "aliases": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "family"
        ],
        "properties": {
          "family": {
            "type": "string"
          },
          "facets": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "note": {
            "type": "string"
          }
        }
      },
      "description": "Hand-decided alias rows for registry peer-dependency keys the mechanical rules (host.<family>, openwop.<family>.<facet>, <family>.<facet>) cannot explain (RFC 0177 §B.2)."
    }
  }
}
