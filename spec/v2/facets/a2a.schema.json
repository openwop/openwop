{
  "$comment": "RFC 0175 §B.1/§C/§D",
  "properties": {
    "versions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[0-9]+\\.[0-9]+$"
      }
    },
    "preferredVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "minimumVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "refreshedAt": {
      "type": "string",
      "format": "date"
    },
    "profiles": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^a2a-[0-9]+\\.[0-9]+$"
      }
    },
    "agentCardUrl": {
      "type": "string",
      "format": "uri"
    },
    "streaming": {
      "type": "boolean"
    },
    "pushNotifications": {
      "type": "boolean"
    },
    "durableTasks": {
      "type": "boolean"
    },
    "agentCards": {
      "const": true,
      "description": "RFC 0202. Present ⇒ each inventory entry with an `a2aTenant` is published as an A2A 1.0 AgentCard through GetExtendedAgentCard with tenant = a2aTenant (interop.md §Per-agent cards). Requires the a2a-1.0 profile and agents.manifestRuntime. Omit when not offered (RFC 0192)."
    }
  },
  "required": [
    "versions",
    "preferredVersion",
    "minimumVersion",
    "refreshedAt"
  ]
}
