{
  "$comment": "RFC 0175 §B.1/§D/§E",
  "properties": {
    "revisions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "format": "date"
      }
    },
    "preferredVersion": {
      "type": "string",
      "format": "date"
    },
    "minimumRevision": {
      "type": "string",
      "format": "date"
    },
    "refreshedAt": {
      "type": "string",
      "format": "date"
    },
    "profiles": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^mcp-[0-9]{4}-[0-9]{2}-[0-9]{2}$"
      }
    },
    "features": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "serverUrls": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uri"
      }
    },
    "serverMount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "transports": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "stdio",
              "streamable-http"
            ]
          }
        }
      }
    },
    "mrtr": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maxRounds"
      ],
      "properties": {
        "maxRounds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16
        }
      }
    }
  },
  "required": [
    "revisions",
    "preferredVersion",
    "minimumRevision",
    "refreshedAt"
  ]
}
