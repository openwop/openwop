    "isolationModel": {
      "type": "string",
      "enum": [
        "wasm",
        "process",
        "container",
        "vm"
      ]
    },
    "allowedHostCalls": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "memoryLimitBytes": {
      "type": "integer",
      "minimum": 1
    },
    "wallClockLimitMs": {
      "type": "integer",
      "minimum": 1
    }
  },
  "required": [
