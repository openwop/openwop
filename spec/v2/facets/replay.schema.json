{
  "$comment": "RFC 0173 §A.1/§C — sideEffectSuppression is not a flag; suppression binds with replay and is witnessed by the effect-seam manifest at GET /host/effect-seams",
  "properties": {
    "modes": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "fork",
          "branch",
          "rerun"
        ]
      }
    },
    "retention": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "days": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "effectSeamsManifest": {
      "const": "/host/effect-seams"
    }
  },
  "required": [
    "modes",
    "effectSeamsManifest"
  ]
}
