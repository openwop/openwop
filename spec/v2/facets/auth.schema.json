{
  "$comment": "RFC 0170 §B.2–§B.5; the fourteen gate flags and subjectLinking are gone (RFC 0173 §A.1, RFC 0170 §C.2)",
  "properties": {
    "lanes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "lane",
          "issuers",
          "revocation",
          "minimumAssurance"
        ],
        "properties": {
          "lane": {
            "type": "string",
            "enum": [
              "api-key",
              "oauth2",
              "oidc",
              "mtls",
              "saml",
              "scim",
              "ldap",
              "workload",
              "session",
              "anonymous"
            ]
          },
          "issuers": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "revocation": {
            "type": "string",
            "enum": [
              "next-request",
              "exp-and-recheck",
              "exp-only",
              "crl",
              "ocsp",
              "short-lived",
              "not-on-or-after",
              "bound-connection",
              "rebind",
              "delegation-expiry"
            ]
          },
          "revocationWindowSeconds": {
            "type": "integer",
            "minimum": 1
          },
          "minimumAssurance": {
            "type": "string",
            "enum": [
              "bearer",
              "sender-constrained",
              "key-bound"
            ]
          },
          "delegationProofs": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "mtls-key-binding",
                "dpop",
                "svid-chain"
              ]
            }
          }
        },
        "$comment": "RFC 0210 §C — `exp-only` MUST NOT be advertised on `api-key` or `session`: there the host issued the credential itself, so revocation is in its own hands. The antecedent is the NEW member only, so no document that validates today can be invalidated by it. The full lane -> rule binding is deliberately NOT here (it would retroactively invalidate a committed bundle); it lives in the suite, and scripts/check-lane-revocation-rules.mjs keeps the table, this enum and the suite map in lockstep.",
        "if": {
          "properties": {
            "revocation": {
              "const": "exp-only"
            }
          },
          "required": [
            "revocation"
          ]
        },
        "then": {
          "properties": {
            "lane": {
              "not": {
                "enum": [
                  "api-key",
                  "session"
                ]
              }
            }
          }
        }
      }
    },
    "subjectLinkKey": {
      "type": "string",
      "enum": [
        "opaque-idp",
        "configured-immutable"
      ]
    }
  },
  "required": [
    "lanes"
  ]
}
