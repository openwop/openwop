# Production-build env vars for the openwop sample app.
#
# Vite auto-loads this file when running `vite build` (production mode
# is the default for `build`). The values are inlined into the bundle
# at build time, NOT read at runtime — so producing a correct
# production bundle is now a no-arg `npm run build` away.
#
# Override per-deployment with `.env.production.local` (gitignored) or
# by passing env vars on the command line.
#
# `vite.config.ts` asserts VITE_OPENWOP_BASE_URL is set + non-default
# in production mode. Don't ship a build with these unset.

# Backend URL. `/api` is same-origin and proxies to the Cloud Run
# service `openwop-app-backend` via the Firebase Hosting rewrite in
# `firebase.json` (app target). Adopters deploying to their own
# infrastructure should override this — either change it here for the
# upstream-tracked production target, or set
# `.env.production.local`/CLI env for a fork.
VITE_OPENWOP_BASE_URL=/api

# Cookie auth — the backend's P0.2 session middleware mints an
# openwop.session cookie. `cookie` mode uses `credentials: 'include'`
# on every fetch and drops the Authorization header. Switching to
# `bearer` requires a real apiKey in VITE_OPENWOP_API_KEY.
VITE_OPENWOP_AUTH_MODE=cookie

# Firebase Auth (P3.2) — Google + GitHub sign-in via the Firebase JS
# SDK. Values come from `firebase apps:sdkconfig WEB <appId>`. Leaving
# these unset disables the sign-in UI (the SPA falls back to anon
# cookie mode).
VITE_FIREBASE_API_KEY=AIzaSyDjY8cTwf3rrjFFWASoySft2ziHFX40CIo
VITE_FIREBASE_AUTH_DOMAIN=openwop-dev.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=openwop-dev
