{
  "name": "openwop-workflow-engine-sample",
  "version": "0.1.0",
  "private": true,
  "description": "OpenWOP reference application — Cloud Run-shape TypeScript backend implementing the v1.1 wire contract. Sample / template code; not production-hardened. See ../../README.md.",
  "type": "module",
  "main": "lib/index.js",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "start": "node --env-file-if-exists=.env lib/index.js",
    "build": "rm -rf lib && esbuild src/index.ts --bundle --platform=node --target=node22 --format=esm --outfile=lib/index.js --packages=external --sourcemap --banner:js=\"import { createRequire } from 'module'; const require = createRequire(import.meta.url);\"",
    "build:tsc": "rm -rf dist && tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:conformance": "tsx conformance/run.ts",
    "lint": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@google-cloud/kms": "^5.5.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.55.0",
    "@opentelemetry/resources": "^1.28.0",
    "@opentelemetry/sdk-node": "^0.55.0",
    "@opentelemetry/sdk-trace-node": "^1.28.0",
    "@opentelemetry/semantic-conventions": "^1.28.0",
    "@openwop/openwop": "^1.1.1",
    "ajv": "^8.20.0",
    "better-sqlite3": "^11.5.0",
    "express": "^4.21.0",
    "pg": "^8.20.0",
    "tar-stream": "^3.1.7"
  },
  "devDependencies": {
    "@openwop/openwop-conformance": "^1.1.0",
    "@testcontainers/postgresql": "^11.14.0",
    "@types/better-sqlite3": "^7.6.11",
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.20.0",
    "@types/tar-stream": "^3.1.4",
    "esbuild": "^0.24.0",
    "pg-mem": "^3.0.14",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
